using Gtk 4.0;
using Adw 1;

template $ElevenFailurePage: Adw.Bin {
    child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
            show-title: false;
            show-start-title-buttons: false;
            show-end-title-buttons: false;

            [end]
            Gtk.ToggleButton {
                tooltip-text: _("Show verbose terminal output");
                icon-name: "utilities-terminal-symbolic";
                clicked => $do_show_terminal();
                styles [
                    "pill"
                ]
            }
        }

        Adw.StatusPage status_page {
            title: _("Failure installing {os_name}");
            description: _("There have been errors while trying to install {os_name}, check the logs for more information (WIP)");
            icon-name: "system-logo-white";
        }
    };
}
