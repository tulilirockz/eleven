using Gtk 4.0;
using Adw 1;

template $ElevenInstallationPage: Adw.Bin {
    child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
            show-title: false;
            show-start-title-buttons: false;
            show-end-title-buttons: false;

            [end]
            Gtk.ToggleButton {
                tooltip-text: _("Show verbose terminal output");
                icon-name: "utilities-terminal-symbolic";
                clicked => $do_show_terminal();
                styles [
                    "pill"
                ]
            }
        }


        Overlay {
            Adw.StatusPage status_page {
                title: _("Installating {os_name}");
                description: _("Do not turn off the power.");
                icon-name: "system-logo-white";

                Adw.Spinner {
                  height-request: 40;
                }
            }

            [overlay]
            Gtk.Box terminal_box {
                halign: center;
                orientation: vertical;
                valign: center;
                vexpand: true;
                visible: false;

                Frame {
                    margin-bottom: 12;
                
                    ScrolledWindow {
                        height-request: 600;
                        width-request: 600;

                        TextView terminal_output {
                            editable: false;
                            wrap-mode: char;
                        }
                    }
                }
                Button {
                    label: _("Copy to Clipboard");
                }
            }
        }
    };
}
